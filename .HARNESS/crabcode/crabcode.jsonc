    "worker-easy": {
      "mode": "subagent",
      "description": "Bounded CODE worker for easy tasks; route only when difficulty is explicitly easy.",
      "model": "openai/gpt-6-luna",
      "reasoningEffort": "low",
      "prompt": "{file:./prompts/worker-prompt.md}",
      "permission": { "edit": "allow", "task": "deny" }
    },
    "worker-medium": {
      "mode": "subagent",
      "description": "Bounded CODE worker for medium tasks; route only when difficulty is explicitly medium.",
      "model": "openai/gpt-6-luna",
      "reasoningEffort": "medium",
      "prompt": "{file:./prompts/worker-prompt.md}",
      "permission": { "edit": "allow", "task": "deny" }
    },
    "worker-hard": {
      "mode": "subagent",
      "description": "Bounded CODE worker for hard tasks; route only when difficulty is explicitly hard.",
      "model": "openai/gpt-6.1-sol",
      "reasoningEffort": "high",
      "prompt": "{file:./prompts/worker-prompt.md}",
      "permission": { "edit": "allow", "task": "deny" }
    },
    "worker-astra": {
      "mode": "subagent",
      "description": "Leaf-only worker used only for explicit one-shot escalation of a verified failed hard Sol result.",
      "model": "openai/gpt-6-astra",
      "prompt": "{file:./prompts/worker-prompt.md}",
      "permission": { "edit": "allow", "task": "deny" }
    }
