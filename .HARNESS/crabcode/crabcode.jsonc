{
  "disabled_providers": ["opencode"],
  "provider": {
    "tailnet-llama": {
      "name": "Tailnet llama API",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://letwir-main:11434/v1",
        "apiKey": "{env:llama}"
      },
      "models": {
        "qwen3.8-flash-next-orca-iq3_m": {
          "name": "Qwen3.8 Flash Next Orca IQ3_M"
        }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "*cargo +* install": "ask",
      "*cargo +* install *": "ask",
      "*cargo install": "ask",
      "*cargo install *": "ask",
      "*go -* install": "ask",
      "*go -* install *": "ask",
      "*go install": "ask",
      "*go install *": "ask",
      "*pkg": "ask",
      "*pkg *": "ask"
    },
    "external_directory": "allow",
    "read": "allow",
    "view_image": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "write": "allow",
    "write_files": "allow",
    "apply_patch": "allow"
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "description": "Coordinates confirmed tasks through ETL and delegates bounded research, planning and verification to appropriate subagents."
    },
